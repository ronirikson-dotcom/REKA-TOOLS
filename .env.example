# PostgreSQL / Supabase connection string
# Supabase: pakai "Transaction pooler" dari tombol Connect, mis.
#   postgresql://postgres.<project-ref>:<password>@<host-pooler>:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wms
# Prepared statement: false untuk Supabase transaction pooler (port 6543), true boleh untuk koneksi langsung
DB_PREPARE=false
# Dipakai oleh `npm test` (database akan di-reset setiap test run) — jangan arahkan ke Supabase
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wms_test
# Folder penyimpanan foto check-in & evidence approval (object storage lokal)
STORAGE_DIR=./storage
# URL aplikasi (dipakai untuk link reset password)
APP_URL=http://localhost:3000
